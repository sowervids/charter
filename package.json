{
  "name": "charter-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm depcruise",
    "charter": "node apps/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "fast-check": "^4.8.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
